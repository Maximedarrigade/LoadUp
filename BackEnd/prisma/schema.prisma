generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String
  createdAt            DateTime  @default(now())
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  lastWorkoutDate      DateTime?
  programs             Program[]
  nutritionProfile     NutritionProfile?
  meals                Meal[]
  workoutSessions      WorkoutSession[]
}

model Program {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days        ProgramDay[]
}

model ProgramDay {
  id        String            @id @default(uuid())
  name      String
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  programId String
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]
  sessions  WorkoutSession[]
}

model ProgramExercise {
  id                String           @id @default(uuid())
  name              String
  targetSets        Int
  targetReps        Int
  restDuration      Int
  order             Int              @default(0)
  createdAt         DateTime         @default(now())
  programDayId      String
  programDay        ProgramDay       @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exerciseLibraryId String?
  exerciseLibrary   ExerciseLibrary? @relation(fields: [exerciseLibraryId], references: [id], onDelete: SetNull)
  logs              WorkoutLog[]
  sets              WorkoutSet[]
}

model ExerciseLibrary {
  id               String            @id
  name             String
  gifUrl           String
  bodyParts        String[]
  equipments       String[]
  targetMuscles    String[]
  secondaryMuscles String[]
  instructions     String[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  programExercises ProgramExercise[]

  @@index([name])
}

model WorkoutLog {
  id                String          @id @default(uuid())
  date              DateTime        @default(now())
  weightUsed        Float
  repsDone          Int
  setsDone          Int
  programExerciseId String
  programExercise   ProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)
}

// Une séance = un jour de programme démarré. Tant que finishedAt est null, la séance
// est "en cours" : ses séries peuvent encore être enregistrées ou corrigées.
model WorkoutSession {
  id           String       @id @default(uuid())
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  programDayId String?
  programDay   ProgramDay?  @relation(fields: [programDayId], references: [id], onDelete: SetNull)
  sets         WorkoutSet[]

  @@index([userId, finishedAt])
}

enum SetFeeling {
  easy
  normal
  hard
}

// Une série validée pendant une séance, envoyée à l'API dès sa validation.
model WorkoutSet {
  id                String          @id @default(uuid())
  setIndex          Int
  weightUsed        Float
  repsDone          Int
  // Ressenti déclaré sur la série. Null pour une série dont le ressenti n'a pas été saisi.
  feeling           SetFeeling?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessionId         String
  session           WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  programExerciseId String
  programExercise   ProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionId, programExerciseId, setIndex])
  @@index([programExerciseId])
}

model NutritionProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight        Float
  height        Float
  age           Int
  gender        String
  activityLevel String
  goal          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Meal {
  id          String           @id @default(uuid())
  name        String
  date        DateTime         @default(now())
  createdAt   DateTime         @default(now())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients MealIngredient[]
}

model MealIngredient {
  id              String   @id @default(uuid())
  name            String
  weightInGrams   Float
  caloriesPer100g Float
  proteinPer100g  Float
  openFoodFactsId String?
  createdAt       DateTime @default(now())
  mealId          String
  meal            Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
}
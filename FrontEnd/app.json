{
  "expo": {
    "name": "LoadUp",
    "slug": "LoadUp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_L.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon_L.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon_L.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon_L.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f5f5",
          "image": "./assets/images/black_c_wordmark.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "LoadUp a besoin de la caméra pour scanner le code-barres d'un aliment."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
